# Banco. O docker-compose cria o Postgres com estes valores e a API monta a conexão a partir deles.
POSTGRES_USER=agelink
POSTGRES_PASSWORD=agelink
POSTGRES_DB=agelink
# Onde a API encontra o banco. Fora do Docker: localhost. No compose de produção é sobrescrito para "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: banco gerenciado/externo. Se preenchida, ignora as POSTGRES_* acima.
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Porta HTTP da API
PORT=3010

# Base pública usada para montar a URL curta devolvida (sem barra final)
PUBLIC_BASE_URL="http://localhost:3010"

# Chaves aceitas no header X-API-Key, separadas por vírgula (permite rotação)
API_KEYS="troque-esta-chave"

# Domínios de destino permitidos, separados por vírgula. Vazio = qualquer domínio http/https.
# Um domínio libera também os subdomínios (ex.: exemplo.com libera img.exemplo.com).
ALLOWED_DOMAINS=""
